<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bifrost.App"
             xmlns:local="using:Bifrost"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Placeholder "night blue" accent, used for the sidebar and brand
                 text until Bifrost gets real theming/branding assets. -->
            <Color x:Key="BifrostAccentColor">#4C8DFF</Color>
            <Color x:Key="BifrostSidebarColorDark">#12172B</Color>
            <Color x:Key="BifrostSidebarColorLight">#E7ECFB</Color>

            <SolidColorBrush x:Key="BifrostAccentBrush" Color="{StaticResource BifrostAccentColor}" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BifrostSidebarBrush" Color="{StaticResource BifrostSidebarColorDark}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BifrostSidebarBrush" Color="{StaticResource BifrostSidebarColorLight}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
