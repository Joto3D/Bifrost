<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bifrost.ViewModels"
             x:Class="Bifrost.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel Margin="32" Spacing="12">
        <TextBlock Text="Home" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Setup status, Play Modded / Play Vanilla, and last-launch log summary will live here."
                   TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
</UserControl>
