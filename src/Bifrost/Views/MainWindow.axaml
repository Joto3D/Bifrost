<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bifrost.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="Bifrost.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/bifrost.ico"
        Title="Bifrost"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Game-update banner: shown when GameUpdateWatcher detects Valheim's
             Steam build changed since Bifrost last checked. See MainViewModel. -->
        <Border Grid.Row="0" IsVisible="{Binding ShowGameUpdateBanner}"
                Background="#26E6C13A" BorderBrush="#66E6C13A" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="12,10,12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="16" VerticalAlignment="Top" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding GameUpdateMessage}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding VerifyBepInExStatusLine}" IsVisible="{Binding VerifyBepInExStatusLine, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Opacity="0.7" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Verify BepInEx" Command="{Binding VerifyBepInExCommand}" IsEnabled="{Binding !IsVerifyingBepInEx}" Padding="8,4" FontSize="12" />
                        <Button Content="Check Mod Updates" Command="{Binding CheckModUpdatesCommand}" Padding="8,4" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="&#x2715;" Command="{Binding DismissGameUpdateBannerCommand}"
                        Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- Sidebar navigation: Home / Browse / Installed / Settings -->
            <Border Grid.Column="0" Background="{DynamicResource BifrostSidebarBrush}">
                <DockPanel Margin="0,20,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="20,0,0,24">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource BifrostAccentGradientBrush}" />
                        <TextBlock Text="BIFROST"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BifrostAccentBrush}" />
                    </StackPanel>

                    <ListBox DockPanel.Dock="Top"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             Margin="10,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavigationItem">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           Padding="10,8" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BifrostBadgeTintSoftBrush}" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Active page -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

        </Grid>

        <!-- Whole-window drag-and-drop overlay for installing mod files
             regardless of which tab is active. See MainWindow.axaml.cs. -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="DropOverlay" IsVisible="False"
                Background="#CC000000" IsHitTestVisible="False">
            <Border Background="{DynamicResource BifrostCardBackgroundBrush}" BorderBrush="{DynamicResource BifrostCardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="&#x1F4E5;" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop mod files to install" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text=".zip or .dll" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</Window>
