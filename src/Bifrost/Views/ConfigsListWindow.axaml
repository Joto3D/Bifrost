<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bifrost.ViewModels"
        x:Class="Bifrost.Views.ConfigsListWindow"
        x:DataType="vm:ConfigsListViewModel"
        Title="Configs"
        Width="440" Height="440" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Configs" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <TextBlock IsVisible="{Binding HasNoConfigs}" TextWrapping="Wrap" Opacity="0.7"
                           Text="No .cfg files found. Config files show up here once a mod that uses BepInEx's config system has been run at least once." />

                <StackPanel Spacing="4" IsVisible="{Binding HasMatched}">
                    <TextBlock Text="Mod Configs" FontWeight="SemiBold" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding Matched}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConfigRowViewModel">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                        Command="{Binding $parent[ItemsControl].((vm:ConfigsListViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SubtitleFileName}" Opacity="0.6" FontSize="11" IsVisible="{Binding HasSubtitle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding HasUnmatched}">
                    <TextBlock Text="Other Configs" FontWeight="SemiBold" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding Unmatched}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConfigRowViewModel">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                        Command="{Binding $parent[ItemsControl].((vm:ConfigsListViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
