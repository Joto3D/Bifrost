<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bifrost.ViewModels"
             x:Class="Bifrost.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
    <StackPanel Margin="32" Spacing="12">
        <TextBlock Text="Browse" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Thunderstore mod search, browse, and install will live here."
                   TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
</UserControl>
