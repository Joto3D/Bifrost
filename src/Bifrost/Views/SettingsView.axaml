<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bifrost.ViewModels"
             x:Class="Bifrost.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <StackPanel Margin="32" Spacing="12">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Install paths, log shortcuts, and setup wizard re-run will live here."
                   TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
</UserControl>
